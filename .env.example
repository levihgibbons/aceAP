# AceAP environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) database stored
# in ACEAP_DATA_DIR. No external service is needed for local development.
# Set DATABASE_URL to a real PostgreSQL / Supabase connection string in
# staging and production (the same migrations apply).
DATABASE_URL=
ACEAP_DATA_DIR=.data/pglite

# ── Sessions ────────────────────────────────────────────────────────────────
# Session lifetime in days. Cookies are httpOnly + SameSite=Lax, and Secure in
# production.
SESSION_TTL_DAYS=14

# ── AI tutor (optional) ─────────────────────────────────────────────────────
# The tutor shows an honest "not configured" state until a key is provided.
# AI_PROVIDER: "anthropic" or "none"
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Per-student message cap per rolling hour and max output tokens per reply.
AI_MAX_MESSAGES_PER_HOUR=30
AI_MAX_OUTPUT_TOKENS=700
AI_TIMEOUT_MS=30000

# ── Engagement analytics ────────────────────────────────────────────────────
# Seconds without a meaningful interaction before time stops counting as active.
ACTIVE_TIME_IDLE_THRESHOLD_SECONDS=60

# ── Canvas / LTI 1.3 (optional) ─────────────────────────────────────────────
# The public base URL Canvas will call (must be HTTPS in a real deployment).
APP_BASE_URL=http://localhost:3000
# PEM-encoded RSA private key used to sign LTI service requests and deep-link
# responses. If empty, the integrations page reports the tool key as missing.
LTI_TOOL_PRIVATE_KEY=
LTI_TOOL_KEY_ID=aceap-lti-key-1
# Hosts AceAP may contact for an LMS connection (auth login, token, JWKS, AGS
# and NRPS URLs). Comma-separated; "*.example.com" matches any subdomain of
# example.com (not example.com itself). Replaces the default list when set.
# Default: *.instructure.com,*.canvaslms.com. URLs must be https; private,
# loopback and link-local IP addresses are always rejected; localhost is
# allowed only when NODE_ENV is not "production". Add your own host for a
# self-hosted Canvas (e.g. canvas.school.edu).
LTI_ALLOWED_HOSTS=

# ── Email (password reset) ──────────────────────────────────────────────────
# EMAIL_PROVIDER: unset / "outbox" → development outbox: messages are stored in
# the email_outbox table (never delivered) and readable at /dev/outbox by a
# platform admin. The outbox is NEVER used when NODE_ENV=production; there,
# without a real provider, email is "not configured" and the forgot-password
# page says so honestly. "none" disables email everywhere.
EMAIL_PROVIDER=
EMAIL_FROM="AceAP <no-reply@example.org>"
# Test-only: "1" enables the outbox and an open /dev/outbox page even in a
# production build (used by the Playwright suite). Never set in a deployment.
ACEAP_DEV_OUTBOX=

# ── Account lifecycle & retention (npm run retention) ───────────────────────
# Days a self-deleted account is kept (soft-deleted) before it is purged.
ACCOUNT_PURGE_GRACE_DAYS=30
# Raw engagement telemetry (learning_events, learning_sessions) older than this
# is deleted by `npm run retention -- --apply`. Minimum 30. Mastery evidence,
# responses and snapshots are never deleted by retention.
RETENTION_EVENTS_DAYS=730
