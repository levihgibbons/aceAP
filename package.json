{
  "name": "aceap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:sync": "tsx scripts/content-sync.ts",
    "lms:sync": "tsx scripts/lms-sync.ts",
    "retention": "tsx scripts/retention.ts",
    "setup": "npm run content:validate && npm run db:migrate && npm run db:seed",
    "build:e2e": "node -e \"process.env.NEXT_DIST_DIR=process.env.E2E_DIST_DIR||'.next-e2e';process.env.ACEAP_DATA_DIR='memory';require('child_process').execSync('npx next build',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@electric-sql/pglite": "^0.5.16",
    "@xyflow/react": "^13.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "katex": "^0.19.1",
    "lucide-react": "^1.74.0",
    "mathjs": "^15.2.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
